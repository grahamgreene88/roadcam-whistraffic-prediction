# Copy to .env on the server and fill in. NEVER commit .env (it is in .gitignore).
# All provider-specific values live here, never in code.

# Runtime state: upload buffer, per-camera dedup hashes, sr3 state
DATA_DIR=/var/lib/whistler-traffic

# Sent in the User-Agent of every request
CONTACT_EMAIL=

# Cloudflare R2 (private bucket; API token scoped to this bucket, read/write)
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# healthchecks.io ping URL, one check per logger
HEALTHCHECK_URL_WEBCAMS=
